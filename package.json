{
  "name": "import-and-export-project",
  "version": "1.0.0",
  "description": "Full-Stack Node.js & React.js Professional Architecture",
  "private": true,
  "scripts": {
    "setup": "npm run setup:server && npm run setup:client",
    "setup:server": "cd server && npm install",
    "setup:client": "cd client && npm install",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix client",
    "push": "node scripts/git-push.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
